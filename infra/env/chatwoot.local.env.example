# Copie para a cápsula local como private/env/chatwoot.local.env.
# Este arquivo é um exemplo; não use seus valores em produção.

RAILS_ENV=development
NODE_ENV=development
INSTALLATION_ENV=docker
SECRET_KEY_BASE=generate-a-local-development-secret
FRONTEND_URL=http://127.0.0.1:3000
ENABLE_ACCOUNT_SIGNUP=true
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot_dev
POSTGRES_USERNAME=chatwoot_dev
POSTGRES_PASSWORD=local-only-change-me

REDIS_URL=redis://:local-only-change-me@redis:6379
REDIS_PASSWORD=local-only-change-me

MAILER_SENDER_EMAIL=dev@example.invalid
SMTP_ADDRESS=mailhog
SMTP_PORT=1025
SMTP_AUTHENTICATION=none
SMTP_ENABLE_STARTTLS_AUTO=false

# Compose interpolation; ajuste os caminhos na cápsula da estação.
CHATWOOT_ENV_FILE=
CHATWOOT_POSTGRES_DATA_DIR=
CHATWOOT_REDIS_DATA_DIR=
CHATWOOT_STORAGE_DIR=
