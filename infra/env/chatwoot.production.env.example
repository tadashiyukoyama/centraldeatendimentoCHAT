# Copie para o secret store ou para private/env/chatwoot.production.env.
# Substitua todos os valores marcados antes de iniciar produção.

RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
SECRET_KEY_BASE=rotate-before-use
FRONTEND_URL=https://atendimento.example.com
ENABLE_ACCOUNT_SIGNUP=false
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot_production
POSTGRES_USERNAME=chatwoot_prod
POSTGRES_PASSWORD=rotate-before-use

REDIS_PASSWORD=rotate-before-use
REDIS_URL=redis://:rotate-before-use@redis:6379

MAILER_SENDER_EMAIL=atendimento@example.com
SMTP_DOMAIN=example.com
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=rotate-before-use
SMTP_PASSWORD=rotate-before-use
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# Obrigatórios para o Compose próprio; caminhos apontam para o host, não para o clone.
CHATWOOT_ENV_FILE=/opt/centraldeatendimentoCHAT/private/env/chatwoot.production.env
CHATWOOT_IMAGE=ghcr.io/tadashiyukoyama/centraldeatendimentoCHAT:sha-REPLACE_ME
CHATWOOT_APP_PORT=3000
CHATWOOT_POSTGRES_DATA_DIR=/opt/centraldeatendimentoCHAT/data/postgres
CHATWOOT_REDIS_DATA_DIR=/opt/centraldeatendimentoCHAT/data/redis
CHATWOOT_STORAGE_DIR=/opt/centraldeatendimentoCHAT/data
