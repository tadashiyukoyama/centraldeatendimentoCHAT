# Copie para o secret store ou para private/env/chatwoot.production.env.
# Substitua todos os valores marcados antes de iniciar produção.

RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
SECRET_KEY_BASE=rotate-before-use
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=rotate-before-use
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=rotate-before-use
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=rotate-before-use
FRONTEND_URL=https://chatwoot.example.com
CHATWOOT_DOMAIN=chatwoot.example.com
ICP_PANEL_DOMAIN=vps10054.panel.icontainer.cloud
ENABLE_ACCOUNT_SIGNUP=false
# Keep the self-hosted instance independent from Chatwoot Hub.
DISABLE_TELEMETRY=true
ENABLE_PUSH_RELAY_SERVER=false
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot_production
POSTGRES_USERNAME=chatwoot_prod
POSTGRES_PASSWORD=rotate-before-use

REDIS_PASSWORD=rotate-before-use
REDIS_URL=redis://:rotate-before-use@redis:6379

# Native WhatsApp via QR Code. Enable only after the dedicated Evolution API contract passes preflight.
EVOLUTION_API_ENABLED=false
EVOLUTION_API_URL=https://evolution.example.com
EVOLUTION_API_KEY=rotate-before-use
# Optional additional protection for the Evolution API HTTPS ingress.
# EVOLUTION_API_BASIC_AUTH_USER=
# EVOLUTION_API_BASIC_AUTH_PASSWORD=

MAILER_SENDER_EMAIL=atendimento@example.com
SMTP_DOMAIN=example.com
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=rotate-before-use
SMTP_PASSWORD=rotate-before-use
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# Obrigatórios para o Compose próprio; caminhos apontam para o host, não para o clone.
CHATWOOT_ENV_FILE=/opt/central-atendimento/shared/env/chatwoot.production.env
CHATWOOT_IMAGE=ghcr.io/tadashiyukoyama/centraldeatendimentochat:0000000000000000000000000000000000000000
CHATWOOT_APP_PORT=3000
CHATWOOT_POSTGRES_DATA_DIR=/opt/central-atendimento/shared/storage/postgres
CHATWOOT_REDIS_DATA_DIR=/opt/central-atendimento/shared/storage/redis
CHATWOOT_STORAGE_DIR=/opt/central-atendimento/shared/storage
