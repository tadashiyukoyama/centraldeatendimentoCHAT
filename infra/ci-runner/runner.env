CI_RUNNER_USER=ghr-acelerachat
CI_RUNNER_COMMENT=GitHub_Actions_AceleraChat_CI_nao_produtiva
CI_RUNNER_HOME=/srv/ci/users/ghr-acelerachat
CI_RUNNER_DIR=/srv/ci/runners/acelerachat
CI_RUNNER_CACHE=/srv/ci/cache/acelerachat
CI_RUNNER_NAME=vps10056-acelerachat
CI_RUNNER_LABELS=acelerachat-ci,ubuntu-24.04,docker-rootless,non-production
CI_GITHUB_REPOSITORY_URL=https://github.com/tadashiyukoyama/centraldeatendimentoCHAT
CI_GITHUB_REPOSITORY_SLUG=tadashiyukoyama/centraldeatendimentoCHAT
CI_RUNNER_SERVICE=actions.runner.tadashiyukoyama-centraldeatendimentoCHAT.vps10056-acelerachat.service
CI_CONFIG_DIR=/etc/acelerachat-ci-runner
CI_ENV_FILE=/etc/acelerachat-ci-runner/runner.env
CI_RUNNER_CPU_QUOTA=200%
CI_RUNNER_MEMORY_HIGH=700M
CI_RUNNER_MEMORY_MAX=1000M
CI_RUNNER_TASKS_MAX=4096
CI_DOCKER_CPU_QUOTA=320%
CI_DOCKER_MEMORY_HIGH=3800M
CI_DOCKER_MEMORY_MAX=4300M
CI_DOCKER_TASKS_MAX=8192
CI_MIN_FREE_GIB=18
