{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://centraldeatendimentochat.example/schemas/worktree-ledger.schema.json",
  "title": "Central de Atendimento CHAT worktree ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "canonicalClonePath",
    "worktreesRoot",
    "maxAdditionalWorktrees",
    "actualStateSource",
    "ledgerRole",
    "activeAdditionalWorktrees"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "projectId": { "const": "CENTRAL_ATENDIMENTO_CHAT" },
    "canonicalClonePath": { "const": "<absolute-local-workspace-root>/server" },
    "worktreesRoot": { "const": "<absolute-local-workspace-root>/worktrees" },
    "maxAdditionalWorktrees": {
      "type": "integer",
      "const": 2,
      "minimum": 0
    },
    "actualStateSource": { "const": "git worktree list --porcelain" },
    "ledgerRole": { "const": "purpose-and-lifecycle" },
    "activeAdditionalWorktrees": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "branch", "purpose"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^<absolute-local-workspace-root>/worktrees/[^<>:*?\"|]+$"
          },
          "branch": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "headSha": {
            "type": "string",
            "pattern": "^[0-9a-f]{7,64}$"
          }
        }
      }
    }
  }
}
