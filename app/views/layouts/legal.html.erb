<!DOCTYPE html>
<html lang="<%= english? ? 'en' : 'pt-BR' %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#2563EB">
    <meta name="description" content="AceleraChat — ajuda, privacidade e documentos legais">
    <%= csrf_meta_tags %>
    <title><%= @document&.title || (english? ? 'AceleraChat Legal' : 'AceleraChat Jurídico') %></title>
    <link rel="icon" href="/brand-assets/acelerachat/pwa/favicon-32x32.png" sizes="32x32">
    <style>
      :root { color-scheme: light; --blue:#2563eb; --cyan:#06b6d4; --ink:#0f172a; --muted:#475569; --line:#e2e8f0; --bg:#f8fafc; }
      * { box-sizing: border-box; }
      body { margin:0; background:var(--bg); color:var(--ink); font:16px/1.65 Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
      a { color:var(--blue); text-underline-offset:3px; }
      header { background:#fff; border-bottom:1px solid var(--line); }
      .header-inner,.page { width:min(960px, calc(100% - 32px)); margin:auto; }
      .header-inner { min-height:76px; display:flex; align-items:center; justify-content:space-between; gap:24px; }
      .logo { width:190px; max-height:42px; }
      nav { display:flex; gap:16px; flex-wrap:wrap; font-size:14px; }
      .page { padding:48px 0 72px; }
      .card { background:#fff; border:1px solid var(--line); border-radius:18px; box-shadow:0 14px 40px rgb(15 23 42 / .07); padding:clamp(24px,5vw,56px); }
      h1 { margin:0 0 28px; font-size:clamp(30px,5vw,46px); line-height:1.1; letter-spacing:-.03em; }
      h2 { margin:38px 0 10px; font-size:24px; line-height:1.25; }
      h3 { margin:28px 0 8px; font-size:19px; }
      p,li { color:#334155; }
      code { background:#f1f5f9; border-radius:5px; padding:2px 5px; }
      .language { font-weight:700; white-space:nowrap; }
      .form-grid { display:grid; gap:18px; margin-top:32px; padding-top:32px; border-top:1px solid var(--line); }
      label { display:grid; gap:7px; font-weight:700; }
      input,select,textarea { width:100%; border:1px solid #cbd5e1; border-radius:10px; padding:12px 14px; background:#fff; color:var(--ink); font:inherit; }
      input:focus,select:focus,textarea:focus { outline:3px solid rgb(6 182 212 / .22); border-color:var(--cyan); }
      textarea { min-height:150px; resize:vertical; }
      button { border:0; border-radius:10px; padding:13px 20px; background:linear-gradient(120deg,var(--blue),#1d4ed8); color:#fff; font-weight:800; font:inherit; cursor:pointer; }
      button:hover { filter:brightness(.96); }
      .notice,.errors { border-radius:10px; padding:14px 16px; margin:18px 0; }
      .notice { background:#eff6ff; border:1px solid #bfdbfe; }
      .errors { background:#fff1f2; border:1px solid #fecdd3; color:#9f1239; }
      .status { display:inline-flex; border-radius:999px; padding:5px 11px; background:#dbeafe; color:#1e40af; font-weight:800; }
      footer { padding:26px 16px; text-align:center; color:var(--muted); font-size:14px; }
      @media (prefers-color-scheme: dark) {
        :root { color-scheme:dark; --ink:#f8fafc; --muted:#94a3b8; --line:#263244; --bg:#0f172a; }
        body { background:var(--bg); } header,.card { background:#111c2f; } p,li { color:#cbd5e1; } code,input,select,textarea { background:#172236; color:#f8fafc; border-color:#334155; }
      }
      @media (max-width:700px) { .header-inner { align-items:flex-start; padding:18px 0; flex-direction:column; } .page { padding-top:24px; } }
    </style>
  </head>
  <body>
    <header>
      <div class="header-inner">
        <a href="/hc/acelerachat" aria-label="AceleraChat">
          <img class="logo" src="/brand-assets/acelerachat/logo.svg" alt="AceleraChat">
        </a>
        <nav aria-label="<%= english? ? 'Legal navigation' : 'Navegação jurídica' %>">
          <%= link_to english? ? 'Terms' : 'Termos', legal_terms_path(lang: current_legal_locale) %>
          <%= link_to english? ? 'Privacy' : 'Privacidade', legal_privacy_path(lang: current_legal_locale) %>
          <%= link_to 'Cookies', legal_cookies_path(lang: current_legal_locale) %>
          <%= link_to english? ? 'Data request' : 'Solicitação LGPD', legal_data_request_path(lang: current_legal_locale) %>
        </nav>
        <%= link_to english? ? 'Português' : 'English', legal_language_switch_url, class: 'language' %>
      </div>
    </header>
    <main class="page"><div class="card"><%= yield %></div></main>
    <footer>AceleraChat · <a href="mailto:<%= support_contact_email %>"><%= support_contact_email %></a></footer>
  </body>
</html>
