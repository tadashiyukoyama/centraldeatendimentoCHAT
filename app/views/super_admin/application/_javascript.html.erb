<%#
# Javascript Partial

This partial imports the necessary javascript on each page.
By default, it includes the application JS,
but each page can define additional JS sources
by providing a `content_for(:javascript)` block.
%>

<% Administrate::Engine.javascripts.each do |js_path| %>
  <%= javascript_include_tag js_path %>
<% end %>

<%= yield :javascript %>

<% if Rails.env.test? %>
  <%= javascript_tag do %>
    $.fx.off = true;
    $.ajaxSetup({ async: false });
  <% end %>
<% end %>

<% support_config = ChatwootHub.support_config %>
<% super_admin = SuperAdmin.first %>
<% if support_config.values.all?(&:present?) && super_admin.present? %>
<%
  support_payload = {
    websiteToken: support_config[:support_website_token],
    baseUrl: support_config[:support_script_url]
  }.to_json
  support_user = {
    identifier: ChatwootHub.installation_identifier,
    identifier_hash: support_config[:support_identifier_hash],
    email: super_admin.email,
    name: super_admin.name
  }.to_json
%>
<script>
window.chatwootSettings = {
  hideMessageBubble: true,
};
const supportConfig = <%= raw json_escape(support_payload) %>;
const supportUser = <%= raw json_escape(support_user) %>;

(function(d,t) {
  var BASE_URL = '';
  var g=d.createElement(t),s=d.getElementsByTagName(t)[0];
  g.src= BASE_URL + "/packs/js/sdk.js";
  g.async = true;
  s.parentNode.insertBefore(g,s);
  g.onload=function(){
    window.chatwootSDK.run(supportConfig)
  }
})(document,"script");

window.addEventListener('chatwoot:ready', function() {
  window.$chatwoot.setUser(supportUser.identifier, {
    identifier_hash: supportUser.identifier_hash,
    email: supportUser.email,
    name: supportUser.name
  });
})

</script>
<% end %>
